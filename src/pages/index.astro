---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import MeaningSection from '../components/MeaningSection.astro';
import ValueSection from '../components/ValueSection.astro';
import MarketSection from '../components/MarketSection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import InvestmentSection from '../components/InvestmentSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';

const siteData = await getEntry('site', 'site');
const heroImage = siteData?.data?.heroImage ?? 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/65d846be-d4fc-4c40-4f3a-dce3dbb5e700/public';
---

<BaseLayout>
  <Header />
  <main>
    <Hero image={heroImage} />
    <TrustBar />
    <MeaningSection />
    <ValueSection />
    <MarketSection />
    <UseCasesSection />
    <InvestmentSection />
    <TestimonialsSection />
    <ProcessSection />
    <CTASection />
    <FAQSection />
  </main>
  <Footer />
</BaseLayout>
