---
import {
  ACQUISITION_MAILTO,
  BUY_NOW_MAILTO,
  MAKE_OFFER_MAILTO,
  CONTACT_AGENT_MAILTO,
  formattedPrice,
} from '../config/site';
---

<header class="fixed top-0 left-0 right-0 z-50 glass-nav">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3" aria-label="Primary">
    <a href="/" class="flex items-center gap-3 group min-h-tap">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-300 to-yellow-600 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3c4 4 6 7.2 6 10a6 6 0 11-12 0c0-2.8 2-6 6-10z" />
        </svg>
      </div>
      <div>
        <span class="font-semibold text-lg sm:text-xl tracking-tight text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">LaPlayaEsVida</span>
        <span class="text-[10px] text-[var(--accent)] font-semibold tracking-[0.28em] block -mt-0.5">.COM</span>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-7 text-sm text-[var(--text-muted)]">
      <a href="#value" class="hover:text-[var(--accent)] transition-colors min-h-tap inline-flex items-center" data-i18n="nav.why">Why This Domain</a>
      <a href="#market" class="hover:text-[var(--accent)] transition-colors min-h-tap inline-flex items-center" data-i18n="nav.market">Market</a>
      <a href="#uses" class="hover:text-[var(--accent)] transition-colors min-h-tap inline-flex items-center" data-i18n="nav.uses">Perfect For</a>
      <a href="/guides/" class="hover:text-[var(--accent)] transition-colors min-h-tap inline-flex items-center" data-i18n="nav.guides">Guides</a>
      <a href="#process" class="hover:text-[var(--accent)] transition-colors min-h-tap inline-flex items-center" data-i18n="nav.process">How It Works</a>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="lang-toggle"
        class="tap-target inline-flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-strong)] px-3 text-sm font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
        aria-label="Switch language"
        title="Español"
      >
        <svg class="w-4 h-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-width="1.8" />
          <path stroke-width="1.8" d="M3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3z" />
        </svg>
        <span id="lang-toggle-label">ES</span>
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="tap-target inline-flex items-center justify-center rounded-xl border border-[var(--border-strong)] px-3 text-sm text-[var(--text-muted)] hover:text-[var(--text)]"
        data-i18n-aria="theme.toggle"
        aria-label="Toggle light and dark mode"
      >
        <span class="theme-icon-dark hidden" data-i18n="theme.dark">Dark</span>
        <span class="theme-icon-light" data-i18n="theme.light">Light</span>
      </button>

      <a
        href={BUY_NOW_MAILTO}
        class="hidden sm:inline-flex btn-primary text-sm px-5"
        data-cta="nav-buy-now"
        data-i18n="nav.buy"
        data-i18n-price={formattedPrice}
      >
        Buy Now · {formattedPrice}
      </a>

      <button
        type="button"
        id="mobile-nav-toggle"
        class="lg:hidden tap-target inline-flex items-center justify-center rounded-xl border border-[var(--border-strong)] px-3"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-i18n-aria="nav.open"
        aria-label="Open menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="lg:hidden hidden border-t border-[var(--border-strong)] bg-[var(--bg-elevated)]">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1 text-[var(--text)]">
      <a href="#value" class="tap-target flex items-center px-3 rounded-xl hover:bg-[var(--bg-soft)]" data-i18n="nav.why">Why This Domain</a>
      <a href="#market" class="tap-target flex items-center px-3 rounded-xl hover:bg-[var(--bg-soft)]" data-i18n="nav.market">Market</a>
      <a href="#uses" class="tap-target flex items-center px-3 rounded-xl hover:bg-[var(--bg-soft)]" data-i18n="nav.uses">Perfect For</a>
      <a href="/guides/" class="tap-target flex items-center px-3 rounded-xl hover:bg-[var(--bg-soft)]" data-i18n="nav.guides">Guides</a>
      <a href="#process" class="tap-target flex items-center px-3 rounded-xl hover:bg-[var(--bg-soft)]" data-i18n="nav.process">How It Works</a>
      <div class="grid gap-2 pt-3">
        <a href={BUY_NOW_MAILTO} class="btn-primary" data-cta="mobile-buy-now" data-i18n="nav.buy" data-i18n-price={formattedPrice}>Buy Now · {formattedPrice}</a>
        <a href={MAKE_OFFER_MAILTO} class="btn-accent" data-cta="mobile-make-offer" data-i18n="nav.offer">Make Offer</a>
        <a href={CONTACT_AGENT_MAILTO} class="tap-target inline-flex items-center justify-center rounded-2xl border border-[var(--border-strong)]" data-cta="mobile-contact" data-i18n="nav.contact">Contact Agent</a>
        <a href={ACQUISITION_MAILTO} class="text-center text-sm text-[var(--text-muted)] py-2" data-i18n="nav.inquiry">General inquiry</a>
      </div>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const mobileToggle = document.getElementById('mobile-nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  function syncThemeLabel() {
    const theme = root.getAttribute('data-theme') || 'dark';
    const darkLabel = document.querySelector('.theme-icon-dark');
    const lightLabel = document.querySelector('.theme-icon-light');
    if (!darkLabel || !lightLabel) return;
    if (theme === 'dark') {
      darkLabel.classList.add('hidden');
      lightLabel.classList.remove('hidden');
    } else {
      lightLabel.classList.add('hidden');
      darkLabel.classList.remove('hidden');
    }
  }

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('lp-theme', next);
    } catch {}
    syncThemeLabel();
  });

  mobileToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('hidden') === false;
    mobileToggle.setAttribute('aria-expanded', String(open));
    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    const aria =
      lang === 'es'
        ? open
          ? 'Cerrar menú'
          : 'Abrir menú'
        : open
          ? 'Close menu'
          : 'Open menu';
    mobileToggle.setAttribute('aria-label', aria);
    mobileToggle.setAttribute('data-i18n-aria', open ? 'nav.close' : 'nav.open');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      mobileToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  syncThemeLabel();
</script>
