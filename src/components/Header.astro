---
import { ACQUISITION_MAILTO } from '../config/site';
---

<header class="fixed top-0 left-0 right-0 z-50 glass-nav">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-yellow-600 flex items-center justify-center">
        <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <span class="font-semibold text-xl tracking-tighter text-white group-hover:text-gold-400 transition-colors">LaPlayaEsVida</span>
        <span class="text-xs text-gold-400 font-medium tracking-[3px] block -mt-0.5">.COM</span>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm text-slate-300">
      <a href="#value" class="hover:text-gold-400 transition-colors">Why This Domain</a>
      <a href="#market" class="hover:text-gold-400 transition-colors">Market</a>
      <a href="#uses" class="hover:text-gold-400 transition-colors">Perfect For</a>
      <a href="#process" class="hover:text-gold-400 transition-colors">How It Works</a>
    </div>

    <a
      href={ACQUISITION_MAILTO}
      class="px-6 py-2.5 bg-white text-slate-950 font-semibold text-sm rounded-2xl hover:bg-amber-50 transition-all conversion-cta"
    >
      Secure This Asset
    </a>
  </nav>
</header>
