---
import { ACQUISITION_MAILTO, SITE } from '../config/site';

const disclaimerDate = 'July 2026';
---

<footer class="relative border-t border-slate-800 bg-slate-950">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Sophisticated Domain Acquisition CTA -->
    <div class="relative overflow-hidden rounded-3xl border border-gold-400/25 bg-gradient-to-br from-slate-900 via-slate-950 to-gold-400/10 p-8 sm:p-12 mb-12">
      <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-gold-400/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-amber-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="text-xs uppercase tracking-[3px] text-gold-400 font-extrabold mb-4">Domain Available for Acquisition</p>
          <h2 class="font-serif text-3xl sm:text-4xl tracking-tight mb-4 text-white">
            laplayaesvida.com — A Culturally Defining Digital Asset
          </h2>
          <p class="text-slate-400 max-w-xl leading-relaxed">
            "The Beach Is Life" in its most ownable form — a rare exact-phrase .com with instant emotional resonance across 636M+ Spanish speakers and global lifestyle markets. Serious buyers may inquire for pricing, transfer logistics, and escrow options.
          </p>
        </div>

        <div class="rounded-2xl p-6 sm:p-8 border border-white/10 bg-slate-950/90 backdrop-blur-xl">
          <p class="text-xs uppercase tracking-[2px] text-slate-500 font-semibold mb-2">Acquisition Contact</p>
          <a
            href={`mailto:${SITE.email}`}
            class="block text-2xl sm:text-3xl font-serif text-white hover:text-gold-400 transition-colors break-all"
          >
            {SITE.email}
          </a>
          <a
            href={ACQUISITION_MAILTO}
            class="mt-6 inline-flex w-full items-center justify-center gap-3 px-6 py-4 bg-gradient-to-r from-gold-400 to-amber-500 text-slate-950 font-extrabold rounded-2xl hover:brightness-110 transition-all"
          >
            <span>Inquire About Acquisition</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <p class="mt-4 text-[11px] text-slate-500 text-center tracking-wide">
            Confidential inquiries &bull; Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="text-xs text-slate-500 leading-relaxed max-w-4xl mb-10">
      This website is for demonstration and informational purposes only. It does not constitute an offer of services,
      a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
      technologies are based on publicly available information as of {disclaimerDate} and are subject to change.
    </p>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col md:flex-row gap-y-4 items-center justify-between">
      <div>&copy; {new Date().getFullYear()} LaPlayaEsVida.com. All rights reserved.</div>
      <span>Premium domain listing by owner</span>
    </div>
  </div>
</footer>
