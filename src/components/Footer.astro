---
import {
  BUY_NOW_MAILTO,
  MAKE_OFFER_MAILTO,
  CONTACT_AGENT_MAILTO,
  SITE,
  formattedPrice,
} from '../config/site';

const disclaimerDate = 'September 2026';
---

<footer class="relative border-t border-[var(--border-strong)] bg-[var(--bg)]">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="relative overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-elevated)] p-8 sm:p-12 mb-12">
      <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[var(--accent)]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="section-kicker mb-4">Domain available for acquisition</p>
          <h2 class="heading-serif text-3xl sm:text-4xl tracking-tight mb-4 text-[var(--text)]">
            laplayaesvida.com — a culturally defining digital asset
          </h2>
          <p class="text-[var(--text-muted)] max-w-xl leading-relaxed mb-4">
            “The Beach Is Life” in its most ownable form — a rare exact-phrase .com with instant emotional resonance across 636M+ Spanish speakers and global lifestyle markets.
          </p>
          <p class="text-[var(--accent)] font-semibold text-xl mb-2">{formattedPrice} · In stock</p>
          <div class="flex flex-wrap gap-3 text-sm">
            <a href="/guides/domain-valuation/" class="underline underline-offset-4 text-[var(--text-muted)] hover:text-[var(--accent)]">Domain valuation guide</a>
            <a href="/guides/beach-lifestyle-market/" class="underline underline-offset-4 text-[var(--text-muted)] hover:text-[var(--accent)]">Market trends</a>
            <a href="/guides/success-stories/" class="underline underline-offset-4 text-[var(--text-muted)] hover:text-[var(--accent)]">Success stories</a>
          </div>
        </div>

        <div class="rounded-2xl p-6 sm:p-8 border border-[var(--border-strong)] bg-[var(--bg)]/90 backdrop-blur-xl">
          <p class="text-xs uppercase tracking-[2px] text-[var(--text-faint)] font-semibold mb-2">Acquisition contact</p>
          <a
            href={`mailto:${SITE.email}`}
            class="block text-2xl sm:text-3xl font-serif text-[var(--text)] hover:text-[var(--accent)] transition-colors break-all"
          >
            {SITE.email}
          </a>
          <div class="mt-6 grid gap-2">
            <a href={BUY_NOW_MAILTO} class="btn-primary w-full" data-cta="footer-buy-now">Buy Now</a>
            <a href={MAKE_OFFER_MAILTO} class="btn-accent w-full" data-cta="footer-make-offer">Make Offer</a>
            <a href={CONTACT_AGENT_MAILTO} class="tap-target inline-flex items-center justify-center rounded-2xl border border-[var(--border-strong)]" data-cta="footer-contact">Contact Agent</a>
          </div>
          <p class="mt-4 text-[11px] text-[var(--text-faint)] text-center tracking-wide">
            Confidential inquiries · Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <p class="text-xs text-[var(--text-faint)] leading-relaxed max-w-4xl mb-10">
      This website is for demonstration and informational purposes only. It does not constitute an offer of services,
      a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
      technologies are based on publicly available information as of {disclaimerDate} and are subject to change.
    </p>

    <div class="pt-8 border-t border-[var(--border-strong)] text-xs text-[var(--text-faint)] flex flex-col md:flex-row gap-y-4 items-center justify-between">
      <div>&copy; {new Date().getFullYear()} LaPlayaEsVida.com. All rights reserved.</div>
      <div class="flex gap-4">
        <a href="/robots.txt" class="hover:text-[var(--accent)]">robots.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-[var(--accent)]">Sitemap</a>
        <span>Premium domain listing by {SITE.brand}</span>
      </div>
    </div>
  </div>
</footer>
