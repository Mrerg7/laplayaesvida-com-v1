---
const useCases = [
  { icon: '🏠', title: 'Luxury Real Estate & Developments', desc: 'Beachfront communities, villa collections, or a high-end coastal property portal.' },
  { icon: '🏨', title: 'Resorts, Hospitality & Retreats', desc: 'Boutique hotels, wellness centers, surf retreats, or luxury villa rentals.' },
  { icon: '👗', title: 'Lifestyle & Fashion Brands', desc: 'Premium beachwear, resort collections, lifestyle products, or home & living.' },
  { icon: '✈️', title: 'Travel & Experiential Platforms', desc: 'Curated beach destinations, digital nomad coastal living, or luxury travel clubs.' },
  { icon: '📰', title: 'Media, Content & Community', desc: 'A leading voice in coastal lifestyle media, podcasts, or membership communities.' },
  { icon: '📈', title: 'Investment & Brand Holding', desc: 'A scarce digital asset with strong appreciation potential and brand equity.' },
];
---

<section id="uses" class="bg-slate-900 py-16 border-y border-slate-800">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <div class="text-gold-400 text-xs tracking-[3px] font-semibold mb-2">ENDLESS POSSIBILITIES</div>
      <h2 class="text-4xl sm:text-5xl heading-serif tracking-tight text-white">Built for Visionary Brands</h2>
      <p class="mt-3 text-white/70 max-w-md mx-auto">This domain is the perfect foundation for any business or project that celebrates coastal living.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {useCases.map((item) => (
        <div class="premium-card group bg-slate-950 border border-slate-700 hover:border-gold-400/30 rounded-3xl p-8">
          <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5 mb-6 text-2xl" aria-hidden="true">{item.icon}</div>
          <h3 class="font-semibold text-xl mb-2 text-white">{item.title}</h3>
          <p class="text-sm text-white/70">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
