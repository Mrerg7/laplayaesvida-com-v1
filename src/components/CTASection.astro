---
import { ACQUISITION_MAILTO } from '../config/site';
---

<section class="bg-gradient-to-b from-slate-900 to-slate-950 border-t border-slate-800 py-20">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-4xl sm:text-5xl heading-serif tracking-tighter mb-4 text-white">
      Ready to own<br />The Beach Is Life?
    </h2>
    <p class="text-white/70 mb-8">
      This premium domain is available for serious acquisition. Inquiries from visionary brands and qualified buyers are welcome.
    </p>

    <a
      href={ACQUISITION_MAILTO}
      class="group inline-flex items-center justify-center gap-3 px-14 py-5 bg-white hover:bg-amber-50 text-xl font-semibold text-slate-950 rounded-3xl transition-all shadow-2xl conversion-cta"
    >
      <span>Start the Conversation</span>
      <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

    <p class="text-xs text-white/40 mt-6">Confidential &bull; Escrow Protected &bull; Premium Acquisition</p>
  </div>
</section>
