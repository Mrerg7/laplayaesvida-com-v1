---
import {
  BUY_NOW_MAILTO,
  MAKE_OFFER_MAILTO,
  CONTACT_AGENT_MAILTO,
  formattedPrice,
} from '../config/site';
---

<section class="max-w-5xl mx-auto px-6 py-20 text-center" id="investment">
  <div class="max-w-3xl mx-auto">
    <div class="section-kicker mb-3">Investment perspective</div>
    <h2 class="text-4xl sm:text-5xl md:text-6xl heading-serif tracking-tighter mb-6 text-[var(--text)]">
      A high-value acquisition in a sea of commodities
    </h2>

    <p class="text-xl text-[var(--text-muted)] leading-relaxed mb-6">
      Most premium domains today are either generic or forced. LaPlayaEsVida.com is different. It is an authentic, culturally powerful, and instantly ownable phrase that stands out in any category.
    </p>

    <p class="text-2xl sm:text-3xl font-semibold text-[var(--accent)] mb-4">
      Listed acquisition price: {formattedPrice}
    </p>
    <p class="text-sm text-[var(--text-faint)] mb-8">One-of-one exact-phrase .com · Price tier: Buy Now / Make Offer / Contact Agent</p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
      <a href={BUY_NOW_MAILTO} class="btn-primary" data-cta="investment-buy-now">Buy Now</a>
      <a href={MAKE_OFFER_MAILTO} class="btn-accent" data-cta="investment-make-offer">Make Offer</a>
      <a href={CONTACT_AGENT_MAILTO} class="tap-target inline-flex items-center justify-center rounded-2xl border border-[var(--border-strong)] px-6" data-cta="investment-contact">Contact Agent</a>
    </div>

    <div class="flex flex-wrap justify-center gap-3 text-sm">
      {['Exact phrase .com', 'Bilingual emotional resonance', 'Strong SEO & branding potential', 'Appreciating digital asset'].map((tag) => (
        <div class="px-6 py-3 bg-[var(--bg-elevated)] border border-[var(--border-strong)] rounded-2xl text-[var(--text-muted)]">{tag}</div>
      ))}
    </div>
  </div>
</section>
