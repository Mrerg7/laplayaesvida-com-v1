---
import { faqs } from '../data/faqs';
---

<section class="max-w-4xl mx-auto px-6 pb-20" id="faq" aria-labelledby="faq-heading">
  <div class="text-center mb-10">
    <div class="section-kicker" data-i18n="faq.kicker">Frequently asked questions</div>
    <h2 id="faq-heading" class="sr-only">Frequently asked questions</h2>
  </div>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group border border-[var(--border-strong)] rounded-2xl overflow-hidden bg-[var(--bg-elevated)]">
        <summary class="flex justify-between items-center px-6 sm:px-7 py-5 text-left cursor-pointer hover:bg-[var(--bg-soft)] transition-colors list-none font-medium text-[var(--text)] tap-target">
          <span class="pr-4 text-base">{faq.q}</span>
          <svg class="w-5 h-5 text-[var(--text-faint)] shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-6 sm:px-7 pb-6 text-base text-[var(--text-muted)]">{faq.a}</div>
      </details>
    ))}
  </div>
</section>
